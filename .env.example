# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Environment & Security Settings (development | test | staging | production)
NODE_ENV="development"
PORT="3000"
# Comma-separated allowed origins in production (e.g. https://geotech.example.com)
ALLOWED_ORIGINS=""
# NEVER set ALLOW_LAB_RESET="true" in real production unless performing controlled lab seeding
ALLOW_LAB_RESET="false"
# Set STRICT_FRAME_OPTIONS="true" only when standalone deployment should block iframe embedding
STRICT_FRAME_OPTIONS="false"

# External C++/Python Geospatial Worker (GDAL, PROJ, GEOS, PDAL, PostGIS)
# Development local daemon: http://127.0.0.1:8081
# Production: set HTTPS internal/private service URL & strong random Bearer token via Secrets
GEOSPATIAL_WORKER_URL=""
GEOSPATIAL_WORKER_TOKEN=""
WORKER_TIMEOUT_MS="15000"

# PostGIS Connection (used by Worker & pg_dump/psql system snapshots; NEVER commit real credentials)
POSTGIS_DSN=""
PG_DUMP_BIN="/opt/geo-env/bin/pg_dump"
PSQL_BIN="/opt/geo-env/bin/psql"
MAX_SYSTEM_BACKUPS="10"
